# Copy to backend/.env and fill in. Never commit real values.
# In production these come from Azure Key Vault (injected as environment variables).

# Runtime: development | test | production. Only development and test turn off Secure
# cookies; an unset NODE_ENV is treated as production.
NODE_ENV=development
# Number of reverse proxies in front of the API (e.g. 1 behind one TLS-terminating proxy).
# Needed so rate limits see the client IP. Leave 0 when clients connect directly.
TRUST_PROXY_HOPS=0
# Optional parent domain for the auth cookies, e.g. .example.com when the frontend is on
# app.example.com and the API on api.example.com. The Next.js proxy can only see wk_session
# if it is set for a domain the frontend shares. Frontend and API must share a registrable
# domain (SameSite=Strict); otherwise serve the API same-origin through a Next.js rewrite.
# Leave empty for localhost.
COOKIE_DOMAIN=
# HTTP port the API listens on
PORT=5000
# Exact origin of the Next.js frontend (used for CORS with credentials)
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Neon). TLS with certificate verification is always on (sslmode=disable is
# honoured only for a local or CI database without TLS).
# Pooled URL used by the API (Neon host name ends in -pooler).
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require
# Direct (non-pooled) URL for migrations (npm run db:migrate) and the one-time data copy.
DATABASE_URL_DIRECT=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require
# Separate test database for npm run test:integration (never the main database). Each run
# creates and drops its own schema in it.
DATABASE_URL_TEST=postgresql://<user>:<password>@<test-endpoint>.<region>.aws.neon.tech/<test-database>?sslmode=require&channel_binding=require

# SQL Server: used only by scripts/copy-sqlserver-to-postgres.js (read-only, one-time copy).
# The API no longer reads these.
# MSSQL_SERVER=<sql-server-host>
# MSSQL_DATABASE=<database-name>
# MSSQL_USER=<sql-user>
# MSSQL_PASSWORD=<sql-password>
# true only for local/dev servers with a self-signed certificate
# MSSQL_TRUST_SERVER_CERTIFICATE=false

# JWT RS256 keys. Use EITHER base64-encoded PEM values (production, from Key Vault)...
# JWT_PRIVATE_KEY=<base64-of-private-key-pem>
# JWT_PUBLIC_KEY=<base64-of-public-key-pem>
# ...OR file paths relative to the backend folder (local dev: npm run keys:generate)
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

# Legacy PBKDF2 hashes are upgraded to Argon2id on successful login (users is Workiya-only).
# Default true; set false only to switch the upgrade off.
PASSWORD_REHASH_ON_LOGIN=true

# First SUPER_ADMIN for a fresh database (npm run seed -- --yes). Set only while seeding;
# never commit real values. SEED_COMPANY_NAME defaults to Workiya.
# SEED_ADMIN_EMAIL=<admin email>
# SEED_ADMIN_PASSWORD=<at least 8 characters>
# SEED_COMPANY_NAME=Workiya

# Optional pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
